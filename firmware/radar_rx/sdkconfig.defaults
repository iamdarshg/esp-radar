# RADAR-RX build-time configuration (merged into sdkconfig by esp-idf-sys).
#
# RX is a CSI observation node (STA): no HTTP server, no OTA. It still needs a
# reasonable main-task stack to set up WiFi STA + CSI capture + DSP before
# handing off to the worker tasks, and it inherits the WiFi-CSI component from
# the IDF that radar_csi calls into.

# The main task boots the STA, CSI capture and the DSP pipeline before spawning
# the worker tasks; give it room.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Both RX boards (ESP32 DevKitC and ESP32-CAM) carry 4 MB flash; match the
# layout the partition tooling assumes (the default 2 MB is for the single-app
# table only and would mis-describe the real flash). Selecting the choice's bool
# symbol — the derived `CONFIG_ESPTOOLPY_FLASHSIZE` string is ignored.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Keep the UART console reachable for diagnostics.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# RX2 is the ESP32-CAM, the only PSRAM-equipped board in the head; RX1 (DevKit)
# has none. radar_rx/src/link.rs calls esp_psram_is_initialized() to distinguish
# them. That symbol is only compiled into libesp_psram.a when CONFIG_SPIRAM=y
# (esp_psram/CMakeLists.txt guards `srcs` with `if(CONFIG_SPIRAM)`), so without
# it the release link fails with `undefined reference to esp_psram_is_initialized`.
# CONFIG_SPIRAM also auto-selects CONFIG_SPIRAM_BOOT_INIT, so the boot calls
# esp_psram_init(). IGNORE_NOTFOUND makes a missing PSRAM chip (RX1, and QEMU
# with no PSRAM model) non-fatal: init fails, esp_psram_is_initialized() returns
# false, and resolve_role falls through to RX1. On RX2 init succeeds and the
# inference resolves to RX2.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
